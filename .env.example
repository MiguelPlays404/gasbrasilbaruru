# Cadastre estas variáveis na aba "Environment" do Dokploy (não suba .env para o GitHub)

# Endereço público do site (usado em canonical, sitemap, Open Graph).
# Quando comprar o domínio definitivo, troque aqui (ex: https://gasbrasilbauru.com.br) e faça Redeploy.
VITE_SITE_URL=https://screenshot-to-spark-6156.lovable.app

# Supabase
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave SECRETA (Supabase > Project Settings > API Keys). Nunca vai para o navegador.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
